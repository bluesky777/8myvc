<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
    <!-- Tests de contrato: necesitan la base construida con
             tools/construir-bd-test.sh. Van en su propia suite para poder
             correr las otras sin base de datos. -->
    <testsuite name="Contrato">
      <directory suffix="Test.php">./tests/Contrato</directory>
    </testsuite>
    <!-- Barrido: la herramienta que mide qué alcanza un token de verdad. Tarda,
             no afirma nada e imprime un informe, así que va excluida de la
             corrida normal por su grupo. Ver tests/Barrido/. -->
    <testsuite name="Barrido">
      <directory suffix="Test.php">./tests/Barrido</directory>
    </testsuite>
  </testsuites>
  <groups>
    <exclude>
      <group>barrido</group>
      <!-- Tests ROJOS a proposito: fijan un fallo que espera una decision de
               Joseth, no un arreglo pendiente de escribir. Se excluyen porque un
               rojo permanente dentro de la suite convierte el verde en ruido y el
               siguiente fallo de verdad entra sin que salte nada. Se corren
               pidiendo el grupo `rojo` a artisan test, y el dia que se arreglen se
               les quita el grupo y pasan a la suite: eso es lo que los hace la red
               del arreglo y no una queja archivada. -->
      <group>rojo</group>
    </exclude>
  </groups>
  <php>
    <server name="APP_ENV" value="testing"/>
    <server name="BCRYPT_ROUNDS" value="4"/>
    <server name="CACHE_DRIVER" value="array"/>
    <!-- Base separada, definida en config/database.php. Nunca la de desarrollo:
             los tests de contrato usan RefreshDatabase y truncan lo que encuentren. -->
    <server name="DB_CONNECTION" value="mysql_testing"/>
    <server name="MAIL_MAILER" value="array"/>
    <!-- Sin remitente, Symfony Mailer rechaza el mensaje ("An email must have
             a From or a Sender header") y el reseteo de contraseña responde 500.
             Swift Mailer, el de Laravel 8, no lo comprobaba en el transporte de
             pruebas, así que esto no se notaba. Se fija aquí para que la suite no
             dependa de lo que cada uno tenga en su .env. -->
    <server name="MAIL_FROM_ADDRESS" value="pruebas@ejemplo.test"/>
    <server name="QUEUE_CONNECTION" value="sync"/>
    <server name="SESSION_DRIVER" value="array"/>
    <server name="TELESCOPE_ENABLED" value="false"/>
  </php>
  <source>
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </source>
</phpunit>
