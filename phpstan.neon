includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes
        - tests
        - tools

    # Nivel 5, desde el 20 ago 2026. El 5 comprueba los ARGUMENTOS: si lo que
    # se le pasa a un método es del tipo que ese método pide. Empezó en 45, el
    # número más bajo de todas las subidas, y aun así trajo el fallo más caro de
    # la serie —porque los tipos que no encajan no son todos iguales—.
    #
    # 31 de los 45 eran cadenas donde se esperaba un entero, que PHP convierte
    # solo: 22 `abort('400', …)` y tres `Carbon::createFromDate('2010','08','05')`
    # copiados. Comprobados en el contenedor: funcionan. Se hicieron explícitos y
    # ya, porque dejan de convertirse solos el día que alguien escriba
    # `declare(strict_types=1)` ahí.
    #
    # Cinco eran relaciones Eloquent en la sintaxis de Laravel 4 —`hasMany('Alumno')`,
    # sin namespace—, que no resuelven hoy y que no llama nadie. Borradas.
    #
    # Y **una era `count()` sobre un Builder**, que no se convierte: es un
    # TypeError. `DELETE api/images-users/destroy/{id}` borraba la imagen del
    # disco, limpiaba las cinco referencias y reventaba en la última línea, así
    # que el cliente recibía un error de una operación que sí había ocurrido. En
    # PHP 7 ese mismo `count()` era un warning que devolvía 1. Detrás salió lo
    # que no se buscaba: el guard `persona.propia` estaba puesto en esa ruta y no
    # miraba nada, porque recoge los identificadores por su NOMBRE y esta es la
    # única ruta de imagen que llama `{id}` a lo que sus hermanas llaman
    # `{imagen_id}`. Un alumno borraba la foto de cualquiera. Los dos en
    # 05-codigo-muerto-y-roto.md §13.1 y §13.2, y los dos fijados por ImagenesTest.
    #
    # Lo que queda son los seis de abajo, y son un solo fallo contado tres veces:
    # los tres endpoints del importador con la firma de maatwebsite 2.x. Uno de
    # ellos no estaba en ninguna lista hasta este nivel.

    # Nivel 4, desde el 20 ago 2026. El 4 no comprueba tipos: comprueba si una
    # condición decide algo y si una línea llega a ejecutarse. Empezó en 55 y es
    # el nivel donde estaban los fallos —cambiar la contraseña borraba el correo
    # de recuperación, doce `abort()` inalcanzables, un `case true` que tapaba
    # una fuga—, todos descritos en 05-codigo-muerto-y-roto.md §11.
    #
    # Los 30 últimos eran mecánicos y se cerraron así: 24 se borraron o se
    # simplificaron —bucles vacíos detrás de un `return`, cinco `is_null()` a la
    # derecha de un `||` que ya excluía el null, el `datos_entorno_direccion()`
    # que nadie llama porque lo hace Services\Login—, uno se reescribió sin
    # cambiar comportamiento y **cinco se quedan como están**, con su entrada
    # aquí abajo y su motivo. Ninguno de los cinco es pereza: en tres de ellos la
    # línea que sobra es la única pista de lo que se pretendía, y en los otros dos
    # hay una decisión tomada que dice que se queden.
    #
    # Uno de los borrados merece nombre porque no se escribió muerto: los tres
    # `Request::input('year_selected') == true || ... == 'true'` de los informes.
    # En PHP 7 la rama derecha atrapaba los valores falsy —`0 == 'true'` valía
    # true— y con el salto a PHP 8 dejó de alcanzarse. O sea que el análisis no
    # encontró código muerto, encontró **un cambio de comportamiento del salto de
    # versión** que llevaba ahí sin que nadie lo mirara.
    #
    # Nivel 3, desde el 20 ago 2026. El 3 comprueba los tipos: lo que se asigna
    # a una propiedad, lo que devuelve un método y si la anotación del hijo
    # encaja con la del padre. Empezó en 61 y **no hizo falta ninguna excepción
    # nueva** — es el primer nivel que se cierra con la lista de abajo intacta.
    #
    # De los 61, catorce eran el mismo fallo de verdad: siete columnas
    # `tinyint(1)` que el código escribía con booleanos de PHP, así que la
    # respuesta de la llamada que crea la fila llevaba `false` y la de cualquier
    # lectura posterior llevaba `0`. Otras 19 iguales estaban escondidas detrás
    # de un `Request::input('is_active', true)`, que para el análisis es `mixed`:
    # el nivel enseñó dónde mirar, el grep encontró el resto. Lo fija
    # BanderasDeUnBitTest.
    #
    # Trece más eran una mentira del generador de columnas, que leía el tipo de
    # cada una y tiraba el `NOT NULL`: `?int` donde decía `int`. Se arregló en
    # tools/columnas-en-los-modelos.php, no en los modelos.
    #
    # Los otros 34 no eran fallos: 16 `@var array` del esqueleto de Laravel 8
    # donde el padre declara `array<int, string>`, 13 `foreach` sobre
    # `RouteCollectionInterface` —que no es iterable, aunque la clase concreta
    # que hay detrás sí— y cinco sueltos, entre ellos un `[0]` sobre el entero
    # que devuelve `DB::update()`, que era un warning por cada alumno importado.
    #
    # Nivel 2, desde el 20 ago 2026. El 1 encontró 341 errores y 21 reales; el 2
    # empezó en 465, y de esos 438 eran una anotación falsa: el trait
    # ResuelveElUsuario decía `@property User $user` cuando lo que devuelve
    # `User::fromToken()` no es una fila de `users`, es el contexto aplanado
    # —`year_id`, `persona_id`, `perms`— que termina en un `(object) $array`.
    # Puesto el tipo honesto, `stdClass`, se fueron 381 de golpe.
    #
    # Los siguientes 144 eran columnas de verdad que larastan no podía conocer:
    # el esquema de este proyecto no está en migraciones sino congelado en un
    # volcado SQL (Fase 5), y de ahí no lee. Se resolvió generando las columnas
    # dentro de cada modelo desde el esquema real, con
    # tools/columnas-en-los-modelos.php — no a mano, por la misma razón que
    # ColumnaSegura pregunta al esquema: una lista escrita se queda corta el día
    # que alguien añada un campo.
    #
    # Lo que quedó son siete, y son reales. Ver más abajo.
    #
    # Nivel 1, desde el 19 ago 2026. El 0 solo se queja de cosas que no pueden
    # funcionar —clases que no existen, variables sin definir, propiedades sin
    # declarar— y aun así encontró 207 en este repo. El 1 añade los métodos y
    # las propiedades que no existen en una clase que sí, y encontró 341: de
    # ellos 320 eran los `$this->user` de los controladores, que se callaron con
    # una anotación `@property` en el trait ResuelveElUsuario, y 21 eran reales.
    # Bajarlo, nunca.
    level: 5

    # El esquema real no está en migraciones (ver Fase 5), así que larastan no
    # puede deducir las columnas de los modelos. Sin esto, cada `$alumno->nombres`
    # sería un error de propiedad inexistente y el análisis no diría nada útil.
    checkModelProperties: false

    excludePaths:
        analyse:
            # 990 consultas crudas devuelven stdClass; el análisis de estas dos
            # vistas no aporta nada y sí mucho ruido.
            - app/Exports

    # Cinco endpoints enrutados que responden 500 desde que se escribieron: usan
    # variables que no se definen en ninguna parte. Arreglarlos no es limpieza,
    # es decidir de dónde sale cada valor —y en dos de ellos, si la operación
    # debe existir—. Están descritos uno a uno en
    # docs/migracion/05-codigo-muerto-y-roto.md.
    #
    # El `count` va a propósito: si aparece una variable indefinida más en
    # cualquiera de estos ficheros, el análisis vuelve a fallar.
    ignoreErrors:
        # PUT api/definitivas_periodos/calcular-notas-finales-asignatura
        -
            message: '#^Undefined variable: \$(alumno_id|asignaturas)$#'
            path: app/Http/Controllers/Alumnos/Definitivas.php
            count: 4
        -
            message: '#^Undefined variable: \$asignaturas$#'
            path: app/Http/Controllers/DefinitivasPeriodosController.php
            count: 5
        -
            message: '#^Static method App\\Models\\NotaFinal::alumnos_grupo_nota_final\(\) invoked with 2 parameters, 3 required\.$#'
            path: app/Http/Controllers/DefinitivasPeriodosController.php
            count: 1
        # GET api/editnota/detailed-notas-year
        -
            message: '#^Undefined variable: \$(grupo_id|periodos_a_calcular)$#'
            path: app/Http/Controllers/EditnotaController.php
            count: 3
        # PUT api/piars-config/config
        -
            message: '#^Undefined variable: \$(field|alumno_id|arr|fullPath)$#'
            path: app/Http/Controllers/Piars/PiarsConfigController.php
            count: 4
        # PUT api/uniformes/guardar-cambios
        -
            message: '#^Undefined variable: \$(propiedad|valor|user|user_id)$#'
            path: app/Http/Controllers/UniformesController.php
            count: 4

        # ---- Los que salieron al subir al nivel 1, misma regla que los de
        # arriba: enrutados y rotos, así que se documentan en vez de esconderse.
        # El nivel 0 no los veía porque `Model` y las facades resuelven por
        # `__call`, y para el análisis la clase «podría» responder.

        # GET api/excel-docentes/docentes/{year}/{year_id} · GET api/simat/alumnos
        # `Excel::create()` es la API de maatwebsite/excel 2.x. La 3.x la quitó,
        # y este proyecto lleva en la 3.x desde antes de esta migración. Los
        # exports están fuera de alcance por decisión del plan (§5): reescribir
        # estos dos a la API nueva es rehacer el informe, no arreglarlo.
        #
        # Las dos rutas de arriba estaban mal escritas hasta el 19 ago 2026:
        # decían `api/informes/listado-docentes-excel`, que no existe, y
        # `api/simat/alumnos-exportar`, que sí existe y FUNCIONA —su
        # `Excel::create()` está detrás de un `return`, así que no se alcanza—.
        # La que llega a la API vieja es `api/simat/alumnos`. Las tres las fija
        # ahora ExcelTest, golpeándolas.
        -
            message: '#^Call to an undefined static method Maatwebsite\\Excel\\Facades\\Excel::create\(\)\.$#'
            path: app/Http/Controllers/Informes/ExcelListadoDocentesController.php
            count: 1
        -
            message: '#^Call to an undefined static method Maatwebsite\\Excel\\Facades\\Excel::create\(\)\.$#'
            path: app/Http/Controllers/Informes/SimatController.php
            count: 1

        # GET api/candidatos/conaspiraciones
        # `VtVotacion::actualInscrito()` no existe. Lo que hay es
        # `actualesInscrito()`, que devuelve un array, y aquí el resultado se usa
        # como una sola votación (`$votacion->id`). No es un renombre: hay que
        # decidir cuál de las votaciones es «la suya». Solo revienta para Alumno
        # y Acudiente; para el resto entra por el else y funciona.
        -
            message: '#^Call to an undefined static method App\\Models\\VtVotacion::actualInscrito\(\)\.$#'
            path: app/Http/Controllers/VtCandidatosController.php
            count: 1

        # PUT api/publicaciones/guardar
        # `$para_todos` se define en las dos ramas del if y en ninguna otra; sus
        # cuatro hermanas sí se inicializan a 0 justo encima. Inicializarla
        # cambiaría un 500 por una publicación que no ve nadie, que es peor:
        # hay que decidir qué significa un `publi_para` que no es ninguno de los
        # dos valores conocidos.
        -
            message: '#^Variable \$para_todos might not be defined\.$#'
            path: app/Http/Controllers/Perfiles/PublicacionesController.php
            count: 2

        # PUT api/piars-alumnos/field · PUT api/piars-actas-acuerdo/...
        # `$document` es el resultado de un `DB::update()` dentro de un `if`, y
        # se devuelve fuera. Si el `if` no entra, la respuesta que el frontend
        # espera no existe. Qué devolver entonces es la decisión.
        -
            message: '#^Variable \$document might not be defined\.$#'
            path: app/Http/Controllers/Piars/PiarsActasAcuerdoController.php
            count: 1
        -
            message: '#^Variable \$document might not be defined\.$#'
            path: app/Http/Controllers/Piars/PiarsAlumnosController.php
            count: 2

        # GET api/piars-asignaturas/asignaturas/{grupo_id}/{alumno_id}
        # `$asignaturas` solo se define para Profesor y para Usuario. Un Alumno o
        # un Acudiente llegan al `count()` sin nada. Qué asignaturas ve un alumno
        # de su propio PIAR es la decisión, y no es de programación.
        -
            message: '#^Variable \$asignaturas might not be defined\.$#'
            path: app/Http/Controllers/Piars/PiarsAsignaturasController.php
            count: 4

        # POST api/importar/cartera
        # `return (array)$rr;` — `$rr` no se define en ninguna rama del método.
        -
            message: '#^Variable \$rr might not be defined\.$#'
            path: app/Http/Controllers/Alumnos/ImportarController.php
            count: 1

        # GET api/definitivas_periodos
        # `$profe_id` se define para Profesor y para superusuario —con la
        # condición escrita dos veces, `$user->is_superuser && $user->is_superuser`—
        # y para nadie más. Un secretario entra y llega sin él.
        -
            message: '#^Variable \$profe_id might not be defined\.$#'
            path: app/Http/Controllers/DefinitivasPeriodosController.php
            count: 1

        # PUT api/uniformes/guardar-cambios · el mismo método de arriba, que su
        # autor anotó con «No la estoy usando actualmente». El nivel 1 ve dos de
        # sus variables una segunda vez, en las líneas donde se leen antes de
        # existir.
        -
            message: '#^Variable \$(propiedad|valor) might not be defined\.$#'
            path: app/Http/Controllers/UniformesController.php
            count: 2

        # ---- Los que salieron al subir al nivel 2 (20 ago 2026). Los demás
        # errores del nivel se arreglaron o se anotaron en los modelos; estos
        # tres son fallos de verdad que no se arreglan sin decidir algo, así que
        # van aquí con su motivo y su `count`, no en un baseline.

        # PUT api/periodos/update/{id}
        # `$periodo->year = Request::input('year')` y después `save()`. La tabla
        # `periodos` no tiene columna `year` —tiene `year_id`—, así que el UPDATE
        # sale con «Unknown column 'year' in 'field list'»: comprobado contra la
        # base. Lleva roto desde siempre y no lo llama nadie; `myvc_front` no
        # tiene ninguna llamada a esa ruta.
        #
        # NO se anota como atributo del modelo a propósito: anotarlo escondería
        # el fallo. Lo que falta decidir es qué manda el cliente en `year` —el
        # número del año o el id— y eso no se puede saber sin un cliente que lo
        # llame. Está en docs/migracion/05-codigo-muerto-y-roto.md §9.
        -
            message: '#^Access to an undefined property App\\Models\\Periodo\|Illuminate\\Database\\Eloquent\\Collection\<int, App\\Models\\Periodo\>\:\:\$year\.$#'
            path: app/Http/Controllers/PeriodosController.php
            count: 1

        # POST api/asistencias · POST api/appmobile/asistencias
        # `$datos` es un array y hace `$datos->id = $id`. En PHP 8 eso es
        # «Attempt to assign property "id" on array», un Error, no un aviso: es
        # de los que cambiaron de gravedad con el salto de versión.
        #
        # Y detrás hay otro: el INSERT declara `:asignatura_id` y el array de
        # valores no lo trae, así que la consulta ni llega a ejecutarse. Un fallo
        # tapando a otro, como el `Input::` de la §1.
        #
        # Qué es `asignatura_id` en una asistencia, y qué debe devolver el
        # endpoint —el modelo, o el array que se acaba de armar— son las dos
        # decisiones. §9 del mismo documento.
        -
            message: '#^Cannot access property \$id on array\<string, mixed\>\.$#'
            path: app/Http/Controllers/Tardanzas/AsistenciasController.php
            count: 1
        -
            message: '#^Cannot access property \$id on array\<string, mixed\>\.$#'
            path: app/Http/Controllers/AppMobile/AsistenciasAppController.php
            count: 1

        # ---- Los cinco que quedaron del nivel 4 (20 ago 2026). Los otros 25 se
        # borraron o se reescribieron; estos cinco se quedan **con la línea que
        # sobra puesta**, y eso es lo que hay que entender: aquí la línea muerta
        # es información. Borrarla dejaría el fichero limpio y la pregunta sin
        # responder.

        # PUT api/definitivas_periodos/calcular-notas-finales-asignatura
        # `$alumnos[$i];` suelto, sin asignar a nada, en los dos métodos.
        # **Es la única pista de lo que se pretendía**: el INSERT de la línea
        # siguiente usa `$alumno_id`, que no existe en ningún sitio —está aquí
        # arriba, entre los cinco endpoints rotos—, y lo que debía ir ahí es
        # `$alumnos[$i]->alumno_id`. Quitar la expresión suelta borraría el único
        # rastro de por dónde iba el autor. Se arregla el día que se decida qué
        # devuelve el endpoint, no antes.
        -
            message: '#^Expression "\$alumnos\[\$i\]" on a separate line does not do anything\.$#'
            path: app/Http/Controllers/Alumnos/Definitivas.php
            count: 2

        # PUT api/alumnos/personas-check
        # `$todos_anios = true` fijado a mano, con el `Request::input` comentado
        # justo encima y una rama `else` que no se ejecuta nunca.
        # **Decidido por Joseth el 20 ago 2026: se queda.** Que un profesor vea a
        # todos los estudiantes del plantel sin importar el año es lo que se
        # quiere. La rama `else` no se borra porque dice qué hacía antes, y
        # porque `AsignarAcudienteAOtroModalCtrl.js` sigue mandando
        # `todos_anios: true`: el front cree que el interruptor existe.
        # Está en 05-codigo-muerto-y-roto.md §11.2.
        -
            message: '#^If condition is always true\.$#'
            path: app/Http/Controllers/AlumnosController.php
            count: 1

        # PUT api/aplicacion-descargas/detailed
        # `return $user;` en la segunda línea, y debajo el cuerpo entero del
        # endpoint sin ejecutarse nunca. No se borra por dos razones: es lo único
        # que dice qué pretendía devolver esa pantalla, y si se quitara el
        # `return` el endpoint **respondería 500** —`$resultado` sólo se define
        # dentro del `if ($con_grupos)`—. O sea que el `return` de más está
        # tapando un fallo, como el `Input::` de la §1. Qué debe devolver es una
        # decisión, y hay una app de Flutter que hoy recibe el usuario.
        # 05-codigo-muerto-y-roto.md §12.1.
        -
            message: '#^Unreachable statement - code above always terminates\.$#'
            path: app/Http/Controllers/AplicacionDescargas/InicioController.php
            count: 1

        # GET api/simat/alumnos-exportar
        # La ruta funciona: devuelve `Excel::download(new AlumnosExport, ...)`.
        # Debajo, sin ejecutarse, está la implementación de maatwebsite 2.x, y
        # con ella el `Comentarios()` que escribe las instrucciones de cada
        # columna de la plantilla del SIMAT —«Coloque: MATR, ASIS, RETI, DESE»,
        # «¿Es urbano? SI o NO», «Coloque "No aplica" … si no tiene SISBEN»—.
        # **Eso es la especificación del importador que sí está vivo**: es lo que
        # `ImporterFixer` lee de la hoja que devuelve la secretaría. El export
        # 3.x (`AlumnosSheet`) no las escribe, así que hoy la plantilla sale sin
        # instrucciones y este bloque muerto es el único sitio donde están.
        # 05-codigo-muerto-y-roto.md §12.2.
        -
            message: '#^Unreachable statement - code above always terminates\.$#'
            path: app/Http/Controllers/Informes/SimatController.php
            count: 1

        # ---- Los seis que quedaron del nivel 5 (20 ago 2026). Son un solo
        # fallo contado tres veces —dos argumentos por llamada—: los tres
        # endpoints que llaman a `Excel::import($ruta, function ($reader) {…})`,
        # que es la firma de maatwebsite/excel 2.x. En la 3.x el primer argumento
        # es el objeto de importación y el segundo la ruta, así que el closure
        # llega donde se espera una ruta y `pathinfo()` revienta.
        #
        # Misma familia y mismo motivo que los `Excel::create()` de más arriba:
        # reescribirlos a la API nueva es rehacer el importador, no arreglarlo, y
        # qué debe hacer cada uno —y si la operación debe existir— es una
        # decisión del colegio. Los tres son `GET api/importar`,
        # `POST api/importar/cartera` y `GET api/importar/modificar/{year}`; el
        # tercero no estaba en ninguna lista hasta este nivel, porque el muestreo
        # de la P2 solo golpeaba lecturas sin parámetro y lleva `{year}`.
        #
        # Los tres los fija ExcelTest, golpeándolos. 05 §8, §8.4 y §13.3.
        -
            message: '#^Parameter \#1 \$import of static method Maatwebsite\\Excel\\Facades\\Excel\:\:import\(\) expects object, .+ given\.$#'
            path: app/Http/Controllers/Alumnos/ImportarController.php
            count: 3
        -
            message: '#^Parameter \#2 \$filePath of static method Maatwebsite\\Excel\\Facades\\Excel\:\:import\(\) expects Illuminate\\Http\\UploadedFile\|string, Closure given\.$#'
            path: app/Http/Controllers/Alumnos/ImportarController.php
            count: 3

        # PUT api/respuestas/actividad
        # `$cantidad_pregs = 4;` a mano, con el comentario de su autor al lado
        # («Debo hacer un código que traiga la cantidad de preguntas»), y el
        # `if ($cantidad_pregs > 0)` que lo protege. El porcentaje de cada alumno
        # se calcula **siempre sobre 4 preguntas**, tenga la actividad las que
        # tenga. El `if` no se borra: es el guardia que hará falta el día que el
        # 4 se sustituya por un `COUNT(*)`, y borrarlo dejaría una división por
        # cero esperando. No se arregla desde aquí porque no se puede medir: el
        # módulo de actividades está vacío en la base de desarrollo —0
        # actividades con preguntas, 0 resueltas—, así que no hay forma de saber
        # cuánto se desvía en un colegio real. 05-codigo-muerto-y-roto.md §12.3.
        -
            message: '#^Comparison operation "\>" between 4 and 0 is always true\.$#'
            path: app/Models/WsActividadResuelta.php
            count: 1
