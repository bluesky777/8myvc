APP_NAME=Laravel
APP_ENV=local
APP_KEY=

# Sesión (Fase 3). Todo en minutos salvo la gracia, que va en segundos.
# Los valores por defecto están en config/sesion.php; aquí solo hace falta lo
# que se quiera cambiar en este colegio.
#
#   SESION_ACCESO_TTL=60          el token que viaja en cada petición
#   SESION_REFRESCO_TTL=20160     14 días; decide cuánta inactividad aguanta
#   SESION_GRACIA_REFRESCO=30     segundos que sobrevive un refresco ya rotado
#   SESION_LEGADO_TTL=1440        el token que emite login/credentials (24 h)

# Versión mínima de `myvc_flutter` que ESTE colegio acepta. Es el `versionCode`
# —el `+N` de pubspec.yaml—, no la versión con puntos: `1.4.2+37` es 37.
#
# VACÍO NO BLOQUEA A NADIE, y así es como se despliega: sin número, el campo
# `version_minima_app` ni siquiera viaja en la respuesta del login.
#
# ANTES DE PONER UN NÚMERO, LEER ESTO. Tiene que ser el versionCode de una
# versión que EXISTA EN LA TIENDA. Uno mayor que el publicado deja al colegio
# entero fuera y sin salida: la pantalla de bloqueo manda a Play, y en Play no
# hay nada a lo que actualizar.
#
# Y hoy eso no es hipotético: medido el 25 ago 2026, pubspec.yaml dice `1.0.0+1`
# y la app NUNCA SE HA SUBIDO A PLAY. O sea que ahora mismo cualquier número
# mayor que 1 bloquea a todos los usuarios de este colegio — también un 5 o un 10
# puestos «por si acaso». El único ejemplo seguro hoy es el 1:
#
#   APP_MOVIL_VERSION_MINIMA=1
#
# La app es UNA SOLA para los dieciséis colegios, así que este número se sube una
# vez por retirada, con la misma ceremonia que un despliegue, y NUNCA se copia de
# un colegio a otro sin mirar. Al usuario que sólo tiene cuenta aquí, un dedazo
# sólo se lo arregla alguien tocando el servidor.
APP_MOVIL_VERSION_MINIMA=

APP_DEBUG=true
APP_URL=http://localhost

# Base del SPA de AngularJS. Solo hace falta si el frontend se sirve desde un
# host distinto al de la API; si comparten dominio, déjala vacía.
FRONTEND_URL=

# Orígenes permitidos para CORS, separados por comas.
# Si se deja vacía se mantiene '*', que es el comportamiento antiguo.
# DEFINIRLA EN PRODUCCIÓN, p.ej: https://lalvirtual.edu.co
CORS_ALLOWED_ORIGINS=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Registro de consultas lentas (paso 3 del plan de rendimiento). En estos
# alojamientos no hay acceso al slow_query_log de MySQL, así que lo hace la
# aplicación. En milisegundos; 0 lo deja apagado y no cuesta nada.
# Para medir: ponerlo en 500 una temporada y leerlo con tools/consultas-lentas.py.
CONSULTAS_LENTAS_MS=0
# Anotar también los valores de la consulta. Apagado a propósito: por ahí pasan
# datos personales de menores. Encender solo para reproducir un EXPLAIN concreto.
CONSULTAS_LENTAS_BINDINGS=false

# Caché del contexto de usuario (paso 9). Segundos; 0 lo deja apagado, que es
# como se despliega: medido, ahorra 0,75 ms y tres consultas por petición, que
# es ruido. Encenderlo solo si el registro de consultas lentas de ESE colegio
# dice que allí sí paga. Es un techo de obsolescencia para la configuración del
# año que ve el frontend; los guards releen de la base igual.
CONTEXTO_SEGUNDOS=0

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=usermyvc
DB_PASSWORD=123456

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo. El reseteo de contraseña pasó de la función mail() de PHP al Mail de
# Laravel: mail() fallaba en silencio, Mail lanza excepción.
#
# 'sendmail' reproduce el camino que usaba mail(). Si el servidor tiene un SMTP
# real configurado, úsalo en su lugar.
MAIL_MAILER=sendmail

# Normalmente NO hace falta: por defecto se usa el mismo sendmail_path que usaba
# la función mail() de PHP, que es exactamente el camino que se quiere reproducir.
# Solo se define aquí para forzar otro invocador.
MAIL_SENDMAIL_PATH=

MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# OBLIGATORIOS. El código viejo llevaba el remitente incrustado en las cabeceras
# del mail(); ahora sale de aquí. Si están vacíos, Laravel rechaza el envío
# ANTES de intentarlo y el reseteo devuelve 500.
#
# Y "vacío" no es la única forma de romperlo: MAIL_FROM_ADDRESS=null se lee como
# un null DE VERDAD —Laravel convierte la cadena "null" y el valor por defecto de
# config/mail.php NO llega a aplicarse—, así que se comporta igual que vacío.
# Medido el 2 sep 2026 sobre el .env de producción de cads-itagui, que lo tenía
# así: ese colegio no había enviado un correo nunca. `php artisan correo:probar`
# lo detecta; nadie lo había corrido allí.
#
# El remitente NO es cosmético: hasta el 2 sep 2026 aquí ponía
# josethmaster@lalvirtual.com, y `lalvirtual.com` NO ESTÁ REGISTRADO (dig ->
# NXDOMAIN). Para el receptor eso no es un SPF que falla, es "sender domain does
# not exist", que es un motivo de rechazo más duro. Nadie lo vio porque el
# síntoma es correo que no llega y el reseteo se usa menos de una vez al día.
#
# micolevirtual.com sí existe, tiene MX propio (mail.micolevirtual.com) y su SPF
# autoriza al servidor por dos caminos independientes: +a (la A del dominio es
# 70.32.23.72, la IP del servidor) e ip4:70.32.23.72. Verificado con dig el
# 2 sep 2026. Porqué entero en docs/migracion/28-los-env-no-son-uniformes.md.
MAIL_FROM_ADDRESS=admin@micolevirtual.com
MAIL_FROM_NAME="MiColegioVirtual"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FCM_PROYECTO=micolevirtual-mobile
